<idea-plugin>
  <id>dev.phantom.ktor</id>
  <name>Phantom for Ktor</name>
  <vendor>Phantom</vendor>
  <category>Frameworks</category>
  <description><![CDATA[
  Ktor server support for Phantom: routes from the routing DSL, including routes in Route extension functions with
  the prefixes of their callers, listed in the Endpoints tool window. Does nothing in projects without Ktor.
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <plugin id="com.intellij.java"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java"/>
    <module name="intellij.platform.uast"/>
    <plugin id="org.jetbrains.kotlin"/>
  </dependencies>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij.microservices">
    <endpointsProvider implementation="dev.phantom.ktor.KtorEndpointsProvider"/>
  </extensions>
</idea-plugin>
