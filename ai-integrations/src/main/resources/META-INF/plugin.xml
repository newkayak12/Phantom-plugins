<idea-plugin>
  <id>dev.phantom.ai</id>
  <name>Phantom AI Integration</name>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>Tools</category>
  <description><![CDATA[
  Claude Code and Codex agents next to your projects: a project-group sidebar of repositories, worktrees and agent
  sessions, agent terminals in their own tool window, a workspace board, an agent dashboard and usage in the status bar.
  Needs Phantom Workspaces. The package dev.phantom.ai.api is the public API of this plugin: read-only sessions and worktrees,
  a change listener, and actions to focus or start a session; other plugins use it instead of internals.
  <p>What it sends and changes:</p>
  <ul>
    <li>The agents are the claude and codex command-line tools you installed, run under your own Anthropic or OpenAI
      account. Your prompts, the code and files a session reads, command output and, if you turn the database tools
      on, database query results go to that provider under its terms. The plugin itself sends nothing to them.</li>
    <li>Only after you allow it, it adds its hooks to ~/.claude/settings.json (with the statusLine) and
      ~/.codex/hooks.json; turning this off in Settings | Tools | Phantom AI Integration or uninstalling the plugin
      takes them out again.</li>
    <li>Skipping the agents' permission prompts, the database tools and Remote Control (plain HTTP) are off until you
      turn them on.</li>
  </ul>
  <p>Claude and Claude Code are trademarks of Anthropic; Codex and OpenAI are trademarks of OpenAI. This plugin is not
  affiliated with, sponsored or endorsed by Anthropic or OpenAI. Parts are adapted from Orca (MIT License,
  Copyright (c) 2026 Lovecast Inc.).</p>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <depends>dev.phantom.workspaces</depends>
  <!-- the IDE index queries agents ask through MCP (dev.phantom.localsharedindex.agent) -->
  <depends>dev.phantom.local-shared-index</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <depends>Git4Idea</depends>
  <depends>org.jetbrains.plugins.github</depends>

  <!-- Public API: dev.phantom.ai.api is the only package other plugins may use. PhantomAiApi.getInstance() is a light
       application service (no registration needed). Everything else in dev.phantom.ai.* is internal. -->

  <extensionPoints>
    <extensionPoint qualifiedName="dev.phantom.ai.agentTools" interface="dev.phantom.ai.mcp.AgentTools" dynamic="true"/>
    <!-- where agent terminals show; another plugin can add an external terminal app (see TerminalBackend) -->
    <extensionPoint qualifiedName="dev.phantom.ai.terminalBackend" interface="dev.phantom.ai.terminal.TerminalBackend" dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="dev.phantom.ai">
    <terminalBackend implementation="dev.phantom.ai.terminal.IdeTerminalBackend"/>
    <terminalBackend implementation="dev.phantom.ai.terminal.ITermBackend"/>
    <terminalBackend implementation="dev.phantom.ai.terminal.OsTerminalBackend"/>
    <agentTools implementation="dev.phantom.ai.mcp.IndexAgentTools"/>
  </extensions>

  <!-- with Phantom Database Console: the agents' read-only database tools -->
  <content namespace="jetbrains">
    <module name="phantom.ai.db"/>
  </content>

  <extensions defaultExtensionNs="com.intellij">
    <!-- ===== core (U1) ===== -->
    <toolWindow id="Phantom AI Integration" anchor="right" icon="/icons/phantom/toolwindow/aiIntegration.svg"
                factoryClass="dev.phantom.ai.core.AiToolWindowFactory"/>
    <!-- ===== U3 accounts: applicationConfigurable (append here) ===== -->
    <applicationConfigurable parentId="tools" instance="dev.phantom.ai.accounts.AccountsConfigurable"
                             id="dev.phantom.ai.accounts" displayName="Phantom AI Integration"/>
    <applicationConfigurable parentId="dev.phantom.ai.accounts" instance="dev.phantom.ai.remote.RemoteControlConfigurable"
                             id="dev.phantom.ai.remote" displayName="Remote Control"/>
    <applicationConfigurable parentId="dev.phantom.ai.accounts" instance="dev.phantom.ai.terminal.TerminalConfigurable"
                             id="dev.phantom.ai.terminal" displayName="Terminal"/>
    <!-- ===== U7 usage: statusBarWidgetFactory (append here) ===== -->
    <statusBarWidgetFactory id="dev.phantom.ai.usage" implementation="dev.phantom.ai.usage.UsageStatusBarWidgetFactory"/>
    <fileEditorProvider implementation="dev.phantom.ai.board.BoardFileEditorProvider"/>
    <notificationGroup id="Phantom AI Integration" displayType="BALLOON"/>
    <!-- ===== other extensions (append here) ===== -->
    <editorFactoryListener implementation="dev.phantom.ai.memo.MemoEditorFactoryListener"/>
    <postStartupActivity implementation="dev.phantom.ai.terminal.DetachedSessionsStartup"/>
  </extensions>
  <actions>
    <!-- ===== U4/U5/U6 actions (append here) ===== -->
    <action id="dev.phantom.ai.NewClaudeSession" class="dev.phantom.ai.terminal.NewClaudeSessionAction"
            text="New Claude Session"/>
    <action id="dev.phantom.ai.NewCodexSession" class="dev.phantom.ai.terminal.NewCodexSessionAction"
            text="New Codex Session"/>
    <action id="dev.phantom.ai.ResumeSession" class="dev.phantom.ai.terminal.ResumeSessionAction"
            text="Resume Session"/>
    <action id="dev.phantom.ai.OpenAgentDashboard" class="dev.phantom.ai.dashboard.OpenAgentDashboardAction"
            text="Open Agent Dashboard"/>
    <action id="dev.phantom.ai.OpenBoard" class="dev.phantom.ai.board.OpenBoardAction"
            text="Open Board"/>
    <action id="dev.phantom.ai.AddAiMemo" class="dev.phantom.ai.memo.AddAiMemoAction" text="AI 메모 추가">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="alt shift N"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift N" replace-all="true"/>
    </action>
    <action id="dev.phantom.ai.SendAiMemos" class="dev.phantom.ai.memo.SendAiMemosAction" text="AI 메모 보내기"/>
  </actions>
  <applicationListeners>
    <!-- ===== U2 hooks startup etc. (append here) ===== -->
    <listener class="dev.phantom.ai.hooks.HookStartup" topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="dev.phantom.ai.terminal.DetachedSessionsUnload" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    <!-- uninstalling the plugin takes its hooks out of ~/.claude/settings.json and ~/.codex/hooks.json -->
    <listener class="dev.phantom.ai.hooks.HookUninstall" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    <!-- the agent teams poller starts with the first Claude session that has a session id, not at startup -->
    <listener class="dev.phantom.ai.hooks.AgentTeamsStarter" topic="dev.phantom.ai.core.SessionListener"/>
    <!-- the usage widget asks Codex for its limits only once a Codex session exists, not at startup -->
    <listener class="dev.phantom.ai.usage.UsageStarter" topic="dev.phantom.ai.core.SessionListener"/>
    <!-- a finished session moves its board card from In progress to In review, with or without an open board -->
    <listener class="dev.phantom.ai.board.BoardReviewMover" topic="dev.phantom.ai.core.SessionListener"/>
  </applicationListeners>
</idea-plugin>
