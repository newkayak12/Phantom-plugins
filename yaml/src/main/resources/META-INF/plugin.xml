<idea-plugin package="org.jetbrains.yaml" allow-bundled-update="true">
  <!-- The id and the content module names stay the IntelliJ ones: Phantom-plugins (docker, kubernetes, openapi,
       migrations) and bundled modules depend on them, and the version above the bundled build replaces a still-bundled copy. -->
  <name>YAML</name>
  <id>org.jetbrains.plugins.yaml</id>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>Languages</category>
  <description><![CDATA[
    Provides syntax highlighting and editor features for <a href="https://yaml.org/">YAML</a> language.
    The IntelliJ Community YAML plugin (Apache 2.0), built in Phantom-plugins so it updates without a new Phantom build.
  ]]></description>

  <dependencies>
    <module name="intellij.json"/>
  </dependencies>
  <!-- One jar, so the backend loads embedded with the core module (a module with its own class loader in a non-bundled
       plugin needs a package of its own). No frontend.split or helm module: their sources are not in IntelliJ Community. -->
  <content namespace="jetbrains">
    <module name="intellij.yaml" loading="embedded"/>
    <module name="intellij.yaml.backend" loading="embedded"/>
  </content>
</idea-plugin>
