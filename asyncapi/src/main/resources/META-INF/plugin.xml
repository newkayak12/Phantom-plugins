<idea-plugin>
  <id>dev.phantom.asyncapi</id>
  <name>Phantom for AsyncAPI</name>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>Microservices</category>
  <description><![CDATA[
  AsyncAPI 2 and 3 documents in YAML and JSON: completion and validation from bundled schemas, and gutter links between
  a channel and the Spring Kafka code of its topic (<code>@KafkaListener</code> and <code>KafkaTemplate.send</code>).
  Works offline and only in files whose top level declares <code>asyncapi</code>.
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <plugin id="org.jetbrains.plugins.yaml"/>
    <plugin id="com.intellij.modules.json"/>
    <!-- JsonSchemaProviderFactory lives in this content module of the JSON plugin -->
    <module name="intellij.json.backend"/>
    <plugin id="com.intellij.java"/>
    <!-- Java classes live in the Java plugin's content modules: without these they do not load in Phantom -->
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.java"/>
    <module name="intellij.java.analysis"/>
    <module name="intellij.java.impl"/>
  </dependencies>

  <resource-bundle>messages.AsyncApiBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.lineMarkerProvider language="yaml" implementationClass="dev.phantom.asyncapi.ChannelLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JSON" implementationClass="dev.phantom.asyncapi.ChannelLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.asyncapi.KafkaTopicLineMarkerProvider"/>
  </extensions>
  <extensions defaultExtensionNs="JavaScript.JsonSchema">
    <ProviderFactory implementation="dev.phantom.asyncapi.AsyncApiSchemaProviderFactory"/>
  </extensions>
</idea-plugin>
