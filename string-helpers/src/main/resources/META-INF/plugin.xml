<idea-plugin>
  <id>dev.phantom.string-helpers</id>
  <name>Phantom String Helpers</name>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>Tools</category>
  <description><![CDATA[
  Checks for strings that are code in disguise. Cron expressions in <code>@Scheduled(cron = ...)</code>, Spring's
  <code>CronExpression</code> and <code>CronTrigger</code>, and Quartz's <code>CronScheduleBuilder</code>,
  <code>CronExpression</code> and <code>CronTriggerFactoryBean</code> are validated as Spring or Quartz would parse them,
  and a gutter icon on a valid one lists its next five runs. Java only. Works offline and only in projects with Spring
  scheduling or Quartz.
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <plugin id="com.intellij.java"/>
    <!-- Java classes live in the Java plugin's content modules: without these they do not load in Phantom -->
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.java"/>
    <module name="intellij.java.analysis"/>
    <module name="intellij.java.impl"/>
  </dependencies>

  <resource-bundle>messages.StringHelpersBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <localInspection language="JAVA" enabledByDefault="true" level="ERROR" shortName="PhantomCronExpression"
                     bundle="messages.StringHelpersBundle" key="cron.display.name"
                     groupBundle="messages.StringHelpersBundle" groupKey="group.name"
                     implementationClass="dev.phantom.stringhelpers.cron.CronInspection"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.stringhelpers.cron.CronLineMarkerProvider"/>
  </extensions>
</idea-plugin>
