<idea-plugin>
  <id>dev.phantom.graphql</id>
  <name>Support for GraphQL</name>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>Languages</category>
  <description><![CDATA[
  GraphQL for Phantom: highlighting, brace matching, commenting, navigation, find usages and rename for types and
  fragments in .graphql, .graphqls and .gql files. With Spring GraphQL on the classpath, schema fields and their
  @QueryMapping, @MutationMapping, @SubscriptionMapping, @SchemaMapping and @BatchMapping handlers link to each other
  in the gutter, and Query, Mutation and Subscription fields without a handler are reported. Works offline.
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <plugin id="com.intellij.java"/>
  </dependencies>

  <!-- The JetBrains GraphQL plugin registers the same language and file type -->
  <incompatible-with>com.intellij.lang.jsgraphql</incompatible-with>

  <resource-bundle>messages.GraphQLBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="GraphQL" language="GraphQL" implementationClass="dev.phantom.graphql.lang.GraphQLFileType" fieldName="INSTANCE"
              extensions="graphql;graphqls;gql"/>
    <lang.parserDefinition language="GraphQL" implementationClass="dev.phantom.graphql.lang.GraphQLParserDefinition"/>
    <lang.syntaxHighlighterFactory language="GraphQL" implementationClass="dev.phantom.graphql.lang.GraphQLSyntaxHighlighterFactory"/>
    <annotator language="GraphQL" implementationClass="dev.phantom.graphql.lang.GraphQLAnnotator"/>
    <lang.commenter language="GraphQL" implementationClass="dev.phantom.graphql.lang.GraphQLCommenter"/>
    <lang.braceMatcher language="GraphQL" implementationClass="dev.phantom.graphql.lang.GraphQLBraceMatcher"/>
    <lang.findUsagesProvider language="GraphQL" implementationClass="dev.phantom.graphql.lang.GraphQLFindUsagesProvider"/>

    <codeInsight.lineMarkerProvider language="GraphQL" implementationClass="dev.phantom.graphql.spring.SchemaFieldHandlerLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.graphql.spring.HandlerSchemaFieldLineMarkerProvider"/>
    <localInspection language="GraphQL" shortName="GraphQLUnmappedField" implementationClass="dev.phantom.graphql.spring.GraphQLUnmappedFieldInspection"
                     key="inspection.unmapped.field.name" groupKey="inspection.group" enabledByDefault="true" level="WARNING"/>
  </extensions>
</idea-plugin>
