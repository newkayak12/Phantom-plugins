<idea-plugin>
  <id>dev.phantom.workspaces</id>
  <name>Phantom Workspaces</name>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>User Interface</category>
  <description><![CDATA[
  All open projects in one window, like browser tabs. A tab strip above the editor lists every open project: click to
  switch, middle-click or the close button to close. Only the project in front has a window on screen, the others are
  hidden behind it, so there is one window; a project you open comes in as a new tab. Project windows share one size,
  position and maximized state; a project switched to also takes full screen. A tab can be detached into a window of its own
  (its context menu, or drag it out of the strip) and attached back with Window | Attach to Project Tabs; Open Side by Side in its context menu shows two projects side
  by side over the same place. Next/previous project: Window | Next Project Window. Works on every OS; no native window tabs. Turn it off in Settings | Advanced Settings | Phantom Workspaces.
  ]]></description>

  <resource-bundle>messages.PhantomWorkspacesBundle</resource-bundle>

  <dependencies>
    <plugin id="com.intellij.modules.platform"/>
  </dependencies>

  <!-- IntelliJ's non-modal welcome screen, under its IntelliJ module names. Phantom does not bundle these modules, so
       nothing else claims the names. One jar: the main module's package holds the packages of its frontend and backend
       modules, so none of them can have a class loader filtered to a package of its own; all three load embedded. -->
  <content namespace="jetbrains">
    <module name="intellij.platform.ide.nonModalWelcomeScreen" loading="embedded"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen.frontend" loading="embedded"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen.backend" loading="embedded"/>
  </content>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Home: the welcome screen opens as a project frame (IntelliJ's non-modal welcome screen above) -->
    <welcomeScreenProjectProvider implementation="dev.phantom.workspaces.home.HomeProjectProvider"/>
    <platform.ide.welcomeScreenContentProvider implementation="dev.phantom.workspaces.home.HomeTabContentProvider"/>
    <projectClosingTransitionHandler implementation="dev.phantom.workspaces.home.HomeClosingTransitionHandler"/>
    <ideRootPaneNorth implementation="dev.phantom.workspaces.core.ProjectTabsNorthExtension" order="last"/>
    <advancedSetting id="phantom.workspaces.project.tabs" default="true"
                     bundle="messages.PhantomWorkspacesBundle" groupKey="advanced.settings.phantom.workspaces"/>
    <advancedSetting id="phantom.workspaces.sync.tool.windows" default="true"
                     bundle="messages.PhantomWorkspacesBundle" groupKey="advanced.settings.phantom.workspaces"/>
  </extensions>
  <actions>
    <action id="NextProjectWindow" class="dev.phantom.workspaces.core.NextProjectAction" overrides="true" text="Next Project Window"/>
    <action id="PreviousProjectWindow" class="dev.phantom.workspaces.core.PreviousProjectAction" overrides="true" text="Previous Project Window"/>
    <action id="PhantomWorkspaces.DetachProject" class="dev.phantom.workspaces.core.DetachProjectAction">
      <add-to-group group-id="WindowMenu" anchor="last"/>
    </action>
    <action id="PhantomWorkspaces.AttachProject" class="dev.phantom.workspaces.core.AttachProjectAction">
      <add-to-group group-id="WindowMenu" anchor="last"/>
    </action>
  </actions>
  <applicationListeners>
    <listener class="dev.phantom.workspaces.core.ProjectSwitchActionListener" topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
    <listener class="dev.phantom.workspaces.core.ProjectTabsCloseListener" topic="com.intellij.openapi.project.ProjectCloseListener"/>
    <listener class="dev.phantom.workspaces.core.ProjectTabsSettingListener"
              topic="com.intellij.openapi.options.advanced.AdvancedSettingsChangeListener"/>
  </applicationListeners>
  <projectListeners>
    <listener class="dev.phantom.workspaces.core.ProjectTabsRenameListener" topic="com.intellij.openapi.project.ProjectNameListener"/>
  </projectListeners>
</idea-plugin>
