<idea-plugin>
  <id>dev.phantom.querydsl</id>
  <name>QueryDSL Support</name>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>JVM Frameworks</category>
  <description><![CDATA[
  QueryDSL support for Java and Kotlin: Go to Declaration on a Q class path (<code>order.customer.name</code>,
  <code>QOrder.order</code>) goes to the entity property or entity instead of the generated code; Find Usages of an entity
  field or entity also finds its QueryDSL paths; entities whose Q class is out of date (a field added or removed since
  the last build) are reported.
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <plugin id="com.intellij.java"/>
    <!-- Java classes live in the Java plugin's content modules: without these they do not load in Phantom -->
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.java"/>
    <module name="intellij.java.analysis"/>
    <module name="intellij.java.impl"/>
  </dependencies>

  <resource-bundle>messages.PhantomQueryDslBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <gotoDeclarationHandler implementation="dev.phantom.querydsl.QueryDslGotoDeclaration"/>
    <referencesSearch implementation="dev.phantom.querydsl.QueryDslUsagesSearcher"/>
    <localInspection language="JAVA" enabledByDefault="true" level="WARNING" shortName="PhantomStaleQClass"
                     groupName="QueryDSL" key="inspection.stale" bundle="messages.PhantomQueryDslBundle"
                     implementationClass="dev.phantom.querydsl.StaleQClassInspection"/>
  </extensions>
</idea-plugin>
