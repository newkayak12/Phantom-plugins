<idea-plugin package="dev.phantom.validation.core">
  <dependencies>
    <plugin id="com.intellij.java"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.java"/>
    <module name="intellij.platform.uast"/>
  </dependencies>
  <resource-bundle>messages.PhantomValidationBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <localInspection language="UAST" enabledByDefault="true" level="ERROR" shortName="PhantomConstraintBounds"
                     bundle="messages.PhantomValidationBundle" key="bounds.display.name"
                     groupBundle="messages.PhantomValidationBundle" groupKey="group.name"
                     implementationClass="dev.phantom.validation.core.ConstraintBoundsInspection"/>
    <localInspection language="UAST" enabledByDefault="true" level="ERROR" shortName="PhantomConstraintType"
                     bundle="messages.PhantomValidationBundle" key="type.display.name"
                     groupBundle="messages.PhantomValidationBundle" groupKey="group.name"
                     implementationClass="dev.phantom.validation.core.ConstraintTypeInspection"/>
    <localInspection language="kotlin" enabledByDefault="true" level="WARNING" shortName="PhantomKotlinConstraintTarget"
                     bundle="messages.PhantomValidationBundle" key="target.display.name"
                     groupBundle="messages.PhantomValidationBundle" groupKey="group.name"
                     implementationClass="dev.phantom.validation.core.KotlinConstraintTargetInspection"/>
    <localInspection language="UAST" enabledByDefault="true" level="WEAK WARNING" shortName="PhantomMissingValid"
                     bundle="messages.PhantomValidationBundle" key="valid.display.name"
                     groupBundle="messages.PhantomValidationBundle" groupKey="group.name"
                     implementationClass="dev.phantom.validation.core.MissingValidInspection"/>
    <localInspection language="UAST" enabledByDefault="true" level="WEAK WARNING" shortName="PhantomMissingValidated"
                     bundle="messages.PhantomValidationBundle" key="validated.display.name"
                     groupBundle="messages.PhantomValidationBundle" groupKey="group.name"
                     implementationClass="dev.phantom.validation.core.MissingValidatedInspection"/>
    <localInspection language="UAST" enabledByDefault="true" level="ERROR" shortName="PhantomConstraintDefinition"
                     bundle="messages.PhantomValidationBundle" key="definition.display.name"
                     groupBundle="messages.PhantomValidationBundle" groupKey="group.name"
                     implementationClass="dev.phantom.validation.core.ConstraintDefinitionInspection"/>
  </extensions>
  <applicationListeners>
    <listener class="dev.phantom.validation.core.GhostModeListener" topic="com.intellij.openapi.util.registry.RegistryValueListener"/>
  </applicationListeners>
</idea-plugin>
