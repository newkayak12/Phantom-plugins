<idea-plugin package="dev.phantom.springsecurity.core">
  <dependencies>
    <plugin id="com.intellij.java"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.java"/>
  </dependencies>
  <resource-bundle>messages.PhantomSpringSecurityBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.springsecurity.core.FilterChainLineMarkerProvider"/>
    <localInspection language="JAVA" enabledByDefault="true" level="ERROR" shortName="PhantomRuleAfterAnyRequest"
                     bundle="messages.PhantomSpringSecurityBundle" key="after.any.display.name"
                     groupBundle="messages.PhantomSpringSecurityBundle" groupKey="group.name"
                     implementationClass="dev.phantom.springsecurity.core.RuleAfterAnyRequestInspection"/>
    <localInspection language="JAVA" enabledByDefault="true" level="ERROR" shortName="PhantomShadowedFilterChain"
                     bundle="messages.PhantomSpringSecurityBundle" key="shadowed.display.name"
                     groupBundle="messages.PhantomSpringSecurityBundle" groupKey="group.name"
                     implementationClass="dev.phantom.springsecurity.core.ShadowedFilterChainInspection"/>
  </extensions>
</idea-plugin>
