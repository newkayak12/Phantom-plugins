<idea-plugin>
  <id>dev.phantom.mybatis</id>
  <name>Phantom MyBatis</name>
  <vendor>Phantom</vendor>
  <category>Frameworks</category>
  <description><![CDATA[
  MyBatis support for Phantom IDEA: gutter navigation between mapper interfaces and their XML statements, statement ids,
  <code>resultMap</code>, <code>refid</code>, <code>resultType</code> and <code>property</code> references with
  completion, rename and errors, mapper methods without a statement with a quick fix that writes one into the mapper XML,
  <code>#{...}</code> parameter completion, and SQL highlighting and completion inside mapper XML statements and
  <code>@Select</code> / <code>@Insert</code> / <code>@Update</code> / <code>@Delete</code> when Phantom Database Console
  is installed. Does nothing in projects without MyBatis.
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <plugin id="com.intellij.java"/>
  </dependencies>

  <resource-bundle>messages.PhantomMyBatisBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <fileBasedIndex implementation="dev.phantom.mybatis.MapperNamespaceIndex"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.mybatis.MapperJavaLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="XML" implementationClass="dev.phantom.mybatis.MapperXmlLineMarkerProvider"/>
    <psi.referenceContributor language="XML" implementation="dev.phantom.mybatis.MapperReferenceContributor"/>
    <completion.contributor language="XML" implementationClass="dev.phantom.mybatis.MapperParameterCompletionContributor"/>
    <completion.contributor language="JAVA" implementationClass="dev.phantom.mybatis.MapperParameterCompletionContributor"/>
    <typedHandler implementation="dev.phantom.mybatis.MapperParameterTypedHandler"/>
    <multiHostInjector implementation="dev.phantom.mybatis.MapperSqlInjector"/>
    <localInspection language="XML" enabledByDefault="true" level="ERROR" shortName="PhantomMyBatisMapperXml"
                     bundle="messages.PhantomMyBatisBundle" key="xml.inspection.display.name"
                     groupBundle="messages.PhantomMyBatisBundle" groupKey="group.name"
                     implementationClass="dev.phantom.mybatis.MapperXmlInspection"/>
    <localInspection language="JAVA" enabledByDefault="true" level="WARNING" shortName="PhantomMyBatisMapperMethod"
                     bundle="messages.PhantomMyBatisBundle" key="method.inspection.display.name"
                     groupBundle="messages.PhantomMyBatisBundle" groupKey="group.name"
                     implementationClass="dev.phantom.mybatis.MapperMethodInspection"/>
  </extensions>
</idea-plugin>
