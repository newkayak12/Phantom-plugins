{"names":["vale"],"description":"A syntax-aware linter for prose built with speed and extensibility in mind","subcommands":[{"names":["ls-config"],"description":"Print the current configuration to stdout"},{"names":["ls-metrics"],"description":"Print the given file's internal metrics to stdout","args":[{"name":"file"}]}],"options":[{"names":["--help","-h"],"description":"Show help for vale"},{"names":["--version","-v"],"description":"Print the current version"},{"names":["--ignore-syntax"],"description":"Lint all files line-by-line"},{"names":["--no-exit"],"description":"Don't return a nonzero exit code on errors"},{"names":["--no-wrap"],"description":"Don't wrap CLI output"},{"names":["--ext"],"displayName":"--ext=<ext>","description":"An extension to associate with stdin","separator":"=","args":[{"name":"ext","suggestions":[{"names":[".md"]},{"names":[".rst"]},{"names":[".adoc"]},{"names":[".html"]}]}]},{"names":["--glob"],"displayName":"--glob=<glob>","description":"A glob pattern","separator":"=","args":[{"name":"glob"}]},{"names":["--minAlertLevel"],"displayName":"--minAlertLevel=<level>","description":"The minimum level to display","separator":"=","args":[{"name":"level","suggestions":[{"names":["suggestion"]},{"names":["warning"]},{"names":["error"]}]}]},{"names":["--output"],"displayName":"--output=<style>","description":"The alert output style to use","separator":"=","args":[{"name":"style","suggestions":[{"names":["line"]},{"names":["JSON"]}]}]},{"names":["--config"],"displayName":"--config=<path>","description":"A path to a .vale.ini file","separator":"=","args":[{"name":"path"}]}],"args":[{"isVariadic":true,"templates":["filepaths","folders"]}]}
