<idea-plugin visibility="public" package="com.intellij.terminal.backend">
  <dependencies>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.kernel.backend"/>
    <module name="intellij.platform.ide.impl.wsl"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Phantom: the remote APIs as application services, not a fleet RPC remoteApiProvider (Phantom runs frontend and
         backend in one process, and the RPC compiler plugin that generates their descriptors is not in this build) -->
    <applicationService serviceInterface="org.jetbrains.plugins.terminal.settings.impl.TerminalProjectOptionsRemoteApi"
                        serviceImplementation="com.intellij.terminal.backend.rpc.TerminalProjectOptionsRemoteApiImpl"/>
    <applicationService serviceInterface="org.jetbrains.plugins.terminal.settings.impl.TerminalTabsStorageRemoteApi"
                        serviceImplementation="com.intellij.terminal.backend.rpc.TerminalTabsStorageRemoteApiImpl"/>
    <applicationService serviceInterface="org.jetbrains.plugins.terminal.hyperlinks.rpc.TerminalHyperlinksRemoteApi"
                        serviceImplementation="com.intellij.terminal.backend.hyperlinks.rpc.TerminalHyperlinksRemoteApiImpl"/>
    <applicationService serviceInterface="org.jetbrains.plugins.terminal.hyperlinks.rpc.TerminalHyperlinksSessionRemoteApi"
                        serviceImplementation="com.intellij.terminal.backend.hyperlinks.rpc.TerminalHyperlinksSessionRemoteApiImpl"/>
    <applicationService serviceInterface="org.jetbrains.plugins.terminal.startup.TerminalExecOptionsCustomizationRemoteApi"
                        serviceImplementation="com.intellij.terminal.backend.rpc.TerminalExecOptionsCustomizationRemoteApiImpl"/>
    <applicationService
      serviceInterface="org.jetbrains.plugins.terminal.hyperlinks.menu.BackendHyperlinkInfoService"
      serviceImplementation="com.intellij.terminal.backend.hyperlinks.BackendHyperlinkInfoServiceImpl"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
    <shellsDetector implementation="com.intellij.terminal.backend.WslProjectShellsDetector"/>
  </extensions>
</idea-plugin>