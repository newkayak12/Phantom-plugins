<idea-plugin>
  <id>dev.phantom.kubernetes</id>
  <name>Phantom Kubernetes</name>
  <vendor>Phantom</vendor>
  <category>Cloud</category>
  <description><![CDATA[
  Helm chart support for Phantom IDEA: completion of .Values paths from values.yaml, .Release and .Chart fields and
  include names in chart templates; Ctrl+B from a value to its key and from include to define; and a warning for
  values that values.yaml does not define. Works only inside chart templates.
  Plain Kubernetes manifests are checked for removed API versions, unknown and missing keys, duplicate container
  environment variables and selectors that miss the pod template labels, with key completion for built-in kinds.
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <plugin id="org.jetbrains.plugins.yaml"/>
  </dependencies>

  <resource-bundle>messages.PhantomKubernetesBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <completion.contributor language="any" order="first" implementationClass="dev.phantom.kubernetes.HelmCompletionContributor"/>
    <typedHandler implementation="dev.phantom.kubernetes.HelmTypedHandler"/>
    <gotoDeclarationHandler implementation="dev.phantom.kubernetes.HelmGotoDeclarationHandler"/>
    <!-- _helpers.tpl holds the chart's define blocks; opened as text so completion and Ctrl+B work there too -->
    <fileType name="PLAIN_TEXT" extensions="tpl"/>
    <localInspection enabledByDefault="true" level="WEAK WARNING" shortName="PhantomHelmValues"
                     bundle="messages.PhantomKubernetesBundle" key="values.display.name"
                     groupBundle="messages.PhantomKubernetesBundle" groupKey="group.name"
                     implementationClass="dev.phantom.kubernetes.HelmValuesInspection"/>
    <!-- Kubernetes manifests: built-in kinds only, files without template syntax -->
    <localInspection language="yaml" enabledByDefault="true" level="ERROR" shortName="PhantomK8sApiVersion"
                     bundle="messages.PhantomKubernetesBundle" key="k8s.api.name"
                     groupBundle="messages.PhantomKubernetesBundle" groupKey="group.k8s"
                     implementationClass="dev.phantom.kubernetes.K8sApiVersionInspection"/>
    <localInspection language="yaml" enabledByDefault="true" level="WARNING" shortName="PhantomK8sKeys"
                     bundle="messages.PhantomKubernetesBundle" key="k8s.keys.name"
                     groupBundle="messages.PhantomKubernetesBundle" groupKey="group.k8s"
                     implementationClass="dev.phantom.kubernetes.K8sKeysInspection"/>
    <localInspection language="yaml" enabledByDefault="true" level="WARNING" shortName="PhantomK8sDuplicateEnv"
                     bundle="messages.PhantomKubernetesBundle" key="k8s.env.name"
                     groupBundle="messages.PhantomKubernetesBundle" groupKey="group.k8s"
                     implementationClass="dev.phantom.kubernetes.K8sDuplicateEnvInspection"/>
    <localInspection language="yaml" enabledByDefault="true" level="ERROR" shortName="PhantomK8sSelector"
                     bundle="messages.PhantomKubernetesBundle" key="k8s.selector.name"
                     groupBundle="messages.PhantomKubernetesBundle" groupKey="group.k8s"
                     implementationClass="dev.phantom.kubernetes.K8sSelectorInspection"/>
    <completion.contributor language="yaml" order="first" implementationClass="dev.phantom.kubernetes.K8sCompletionContributor"/>
  </extensions>
</idea-plugin>
