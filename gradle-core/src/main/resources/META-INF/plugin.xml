<idea-plugin url="https://www.jetbrains.com/help/idea/gradle.html">
  <!-- phantom-idea: Phantom's own id; com.intellij.gradle stays as an alias, so plugins depending on the IntelliJ id resolve
       to this one. The content module names stay the IntelliJ ones, as other plugins and bundled modules depend on them by
       name. The bundled IntelliJ Gradle plugin has to be gone, or both claim the same id and modules. -->
  <id>dev.phantom.gradle-core</id>
  <name>Phantom for Gradle</name>
  <module value="com.intellij.gradle"/>
  <category>Build Tools</category>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <description>
    <![CDATA[
      Provides integration with <a href="https://www.gradle.org">Gradle</a> for automation of building, testing, publishing, and deployment of software packages.
      <ul>
      <li>Create a new Gradle project or import an existing Gradle project.</li>
      <li>Edit Gradle files with coding assistance (code completion, inspections, refactoring, and much more).</li>
      <li>Synchronize the project structure with the Gradle model.</li>
      <li>Run Gradle tasks with the Gradle run/debug configuration.</li>
      </ul>
       To use the <b>Gradle</b> tool window, select <b>View | Tool Windows | Gradle</b>.
      ]]>
  </description>

  <content namespace="jetbrains">
    <module name="intellij.gradle" loading="embedded"/>
    <module name="intellij.gradle.toolingExtension" loading="embedded"/>
    <module name="intellij.gradle.toolingExtension.impl" loading="embedded"/>
    <module name="intellij.gradle.toolingProxy" loading="embedded"/>
    <module name="intellij.gradle.completion"/>
    <module name="intellij.gradle.completion.kotlin"/>
    <module name="intellij.gradle.completion.toml"/>
    <module name="intellij.gradle.completion.ex"/>
    <module name="intellij.gradle.properties"/>
    <module name="intellij.gradle.settings" loading="embedded"/>
  </content>

</idea-plugin>
