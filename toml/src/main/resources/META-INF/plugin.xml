<idea-plugin>
    <!-- Phantom's own id; org.toml.lang stays as an alias, so plugins depending on the IntelliJ id resolve to this one. The
         content module names stay the IntelliJ ones: bundled Gradle and Kotlin modules (version catalogs) depend on
         intellij.toml.core. The bundled IntelliJ TOML plugin has to be gone, or both claim the same id and modules. -->
    <id>dev.phantom.toml</id>
    <name>Phantom TOML</name>
    <module value="org.toml.lang"/>
    <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
    <category>Languages</category>

    <description><![CDATA[
      Adds support for the <a href="https://toml.io/en/">TOML</a> configuration file syntax.
      Based on the IntelliJ Community TOML plugin (Apache 2.0).
    ]]></description>

    <dependencies>
        <plugin id="com.intellij.modules.lang"/>
    </dependencies>

    <!-- One jar: a non-bundled plugin's own class loader per module needs a package of its own, and core, backend and
         frontend share org.toml.ide, so they load embedded (json too: JSON is essential). Grazie can be turned off and has
         its own package. -->
    <content namespace="jetbrains">
        <module name="intellij.toml.core" loading="embedded"/>
        <module name="intellij.toml.backend" loading="embedded"/>
        <module name="intellij.toml.frontend" loading="embedded"/>
        <module name="intellij.toml.json" loading="embedded"/>
        <module name="intellij.toml.grazie"/>
    </content>
</idea-plugin>
