<idea-plugin>
  <!-- Phantom's own id; org.editorconfig.editorconfigjetbrains stays as an alias, so plugins depending on the IntelliJ id
       resolve to this one. The content module names stay the IntelliJ ones, as bundled modules depend on them by name.
       The bundled IntelliJ EditorConfig plugin has to be gone, or both claim the same id and modules. -->
  <id>dev.phantom.editorconfig</id>
  <name>Phantom for EditorConfig</name>
  <module value="org.editorconfig.editorconfigjetbrains"/>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>IDE Settings</category>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
  </dependencies>

  <!-- One jar: common (the language) and backend (everything else; other modules depend on it by name) load embedded.
       The frontend and spellchecking modules keep their own class loader on a package of their own, so each switches
       off with what it depends on. No frontend.split (its sources are not in IntelliJ Community). -->
  <content namespace="jetbrains">
    <module name="intellij.editorconfig.common" loading="embedded"/>
    <module name="intellij.editorconfig.frontend"/>
    <module name="intellij.editorconfig.backend" loading="embedded"/>
    <module name="intellij.editorconfig.backend.spellchecking"/>
  </content>

  <description><![CDATA[
    <p>Handles properties in <i>.editorconfig</i> files and applies them to all supported languages.

    <h2>Features</h2>
    <ul>
      <li>Code assistance for all supported properties, standard and extended
    </ul>
    <h2>Getting started</h2>
    <p>For more information, check the documentation for <a href="https://editorconfig.org/">EditorConfig</a> files.
    <p>Based on the IntelliJ Community EditorConfig plugin (Apache 2.0).</p>
  ]]></description>
</idea-plugin>
