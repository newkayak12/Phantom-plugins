<idea-plugin package="dev.phantom.springboot.yaml">
  <dependencies>
    <plugin id="org.jetbrains.plugins.yaml"/>
    <module name="phantom.springBoot.core"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <completion.contributor order="first" language="yaml" implementationClass="dev.phantom.springboot.yaml.BootYamlCompletionContributor"/>
    <lang.documentationProvider language="yaml" order="first" implementationClass="dev.phantom.springboot.yaml.BootYamlDocumentationProvider"/>
    <codeInsight.lineMarkerProvider language="yaml" implementationClass="dev.phantom.springboot.core.BootConfigKeyLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="yaml" implementationClass="dev.phantom.springboot.core.BootProfileOverrideLineMarkerProvider"/>
  </extensions>
</idea-plugin>
