<idea-plugin package="dev.phantom.springboot.core">
  <dependencies>
    <plugin id="com.intellij.java"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java"/>
    <module name="intellij.platform.uast"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.platform.uast.ide"/>
  </dependencies>
  <resource-bundle>messages.PhantomSpringBootBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <gotoDeclarationHandler implementation="dev.phantom.springboot.core.BootConfigGotoDeclarationHandler"/>
    <psi.referenceContributor language="UAST" implementation="dev.phantom.springboot.core.ValuePlaceholderReferenceContributor"/>
    <localInspection enabledByDefault="true" level="WARNING" shortName="PhantomBootConfigKeys"
                     bundle="messages.PhantomSpringBootBundle" key="inspection.key.display.name"
                     groupBundle="messages.PhantomSpringBootBundle" groupKey="inspection.group.name"
                     implementationClass="dev.phantom.springboot.core.BootConfigKeyInspection"/>
    <localInspection enabledByDefault="true" level="WARNING" shortName="PhantomBootDatasourceDriver"
                     bundle="messages.PhantomSpringBootBundle" key="inspection.driver.display.name"
                     groupBundle="messages.PhantomSpringBootBundle" groupKey="inspection.group.name"
                     implementationClass="dev.phantom.springboot.core.BootDatasourceDriverInspection"/>
    <localInspection enabledByDefault="true" level="WARNING" shortName="PhantomBootBootstrapConfig"
                     bundle="messages.PhantomSpringBootBundle" key="inspection.bootstrap.display.name"
                     groupBundle="messages.PhantomSpringBootBundle" groupKey="inspection.group.name"
                     implementationClass="dev.phantom.springboot.core.BootBootstrapConfigInspection"/>
    <localInspection enabledByDefault="true" level="WARNING" shortName="PhantomBootCloudStreamBinding"
                     bundle="messages.PhantomSpringBootBundle" key="inspection.stream.display.name"
                     groupBundle="messages.PhantomSpringBootBundle" groupKey="inspection.group.name"
                     implementationClass="dev.phantom.springboot.core.BootCloudStreamBindingInspection"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.springboot.core.BootConfigPropertiesLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.phantom.springboot.core.BootConfigPropertiesLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.springboot.core.BootApplicationConfigLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.phantom.springboot.core.BootApplicationConfigLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.springboot.core.BootConditionalPropertyLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.phantom.springboot.core.BootConditionalPropertyLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.springboot.core.BootEnableConfigPropertiesLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.phantom.springboot.core.BootEnableConfigPropertiesLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.springboot.core.BootTestPropertiesLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.phantom.springboot.core.BootTestPropertiesLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.phantom.springboot.core.BootConfigPropertyFieldLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.phantom.springboot.core.BootConfigPropertyFieldLineMarkerProvider"/>
  </extensions>
</idea-plugin>
