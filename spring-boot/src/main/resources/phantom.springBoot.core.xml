<idea-plugin package="dev.phantom.springboot.core">
  <dependencies>
    <plugin id="com.intellij.java"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java"/>
    <module name="intellij.platform.uast"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.libraries.gson"/>
  </dependencies>
  <resource-bundle>messages.PhantomSpringBootBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <gotoDeclarationHandler implementation="dev.phantom.springboot.core.BootConfigGotoDeclarationHandler"/>
    <localInspection enabledByDefault="true" level="WARNING" shortName="PhantomBootConfigKeys"
                     bundle="messages.PhantomSpringBootBundle" key="inspection.key.display.name"
                     groupBundle="messages.PhantomSpringBootBundle" groupKey="inspection.group.name"
                     implementationClass="dev.phantom.springboot.core.BootConfigKeyInspection"/>
  </extensions>
</idea-plugin>
