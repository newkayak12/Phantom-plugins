<idea-plugin package="dev.phantom.springboot.run">
  <dependencies>
    <plugin id="com.intellij.java"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java"/>
    <module name="intellij.java.execution"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.libraries.gson"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <configurationType implementation="dev.phantom.springboot.run.SpringBootConfigurationType"/>
    <runConfigurationProducer implementation="dev.phantom.springboot.run.SpringBootRunProducer"/>
    <runConfigurationExtension implementation="dev.phantom.springboot.run.SpringBootProfilesExtension"/>
    <runDashboardDefaultTypesProvider implementation="dev.phantom.springboot.run.SpringBootDashboardTypes"/>
  </extensions>
</idea-plugin>
