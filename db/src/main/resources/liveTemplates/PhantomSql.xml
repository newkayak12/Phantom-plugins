<templateSet group="SQL (Phantom)">
  <template name="sel" value="SELECT * FROM $table$ $END$" description="SELECT * FROM table" toReformat="false" toShortenFQNames="false">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context><option name="PHANTOM_SQL" value="true"/></context>
  </template>
  <template name="selc" value="SELECT count(*) FROM $table$ $END$" description="SELECT count(*) FROM table" toReformat="false" toShortenFQNames="false">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context><option name="PHANTOM_SQL" value="true"/></context>
  </template>
  <template name="selw" value="SELECT * FROM $table$ WHERE $condition$ $END$" description="SELECT * FROM table WHERE condition" toReformat="false" toShortenFQNames="false">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="condition" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context><option name="PHANTOM_SQL" value="true"/></context>
  </template>
  <template name="ins" value="INSERT INTO $table$ ($columns$) VALUES ($values$)$END$" description="INSERT INTO table (columns) VALUES (values)" toReformat="false" toShortenFQNames="false">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="columns" expression="phantomSqlColumns(table)" defaultValue="" alwaysStopAt="true"/>
    <variable name="values" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="PHANTOM_SQL" value="true"/></context>
  </template>
  <template name="upd" value="UPDATE $table$ SET $column$ = $value$ WHERE $condition$$END$" description="UPDATE table SET column = value WHERE condition" toReformat="false" toShortenFQNames="false">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="column" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="value" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="condition" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context><option name="PHANTOM_SQL" value="true"/></context>
  </template>
  <template name="del" value="DELETE FROM $table$ WHERE $condition$$END$" description="DELETE FROM table WHERE condition" toReformat="false" toShortenFQNames="false">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="condition" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context><option name="PHANTOM_SQL" value="true"/></context>
  </template>
  <template name="crt" value="CREATE TABLE $table$ (&#10;    id $type$ PRIMARY KEY,&#10;    $END$&#10;)" description="CREATE TABLE" toReformat="false" toShortenFQNames="false">
    <variable name="table" expression="" defaultValue="&quot;new_table&quot;" alwaysStopAt="true"/>
    <variable name="type" expression="" defaultValue="&quot;BIGINT&quot;" alwaysStopAt="true"/>
    <context><option name="PHANTOM_SQL" value="true"/></context>
  </template>
</templateSet>
