<idea-plugin package="dev.phantom.db.core">
  <dependencies>
    <module name="intellij.grid"/>
    <module name="intellij.grid.core.impl"/>
    <module name="intellij.grid.impl"/>
  </dependencies>
  <resource-bundle>messages.PhantomDbBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="dev.phantom.db.core.drivers.DbDriverRegistry"/>
    <fileType name="Phantom SQL" language="SQL" extensions="sql"
              implementationClass="dev.phantom.db.core.SqlFileType" fieldName="INSTANCE"/>
    <lang.parserDefinition language="SQL" implementationClass="dev.phantom.db.core.SqlParserDefinition"/>
    <lang.syntaxHighlighterFactory language="SQL" implementationClass="dev.phantom.db.core.SqlSyntaxHighlighterFactory"/>
    <lang.commenter language="SQL" implementationClass="dev.phantom.db.core.SqlCommenter"/>
    <lang.braceMatcher language="SQL" implementationClass="dev.phantom.db.core.SqlBraceMatcher"/>
    <completion.contributor language="SQL" implementationClass="dev.phantom.db.core.SqlCompletionContributor"/>
    <annotator language="SQL" implementationClass="dev.phantom.db.core.SqlUnresolvedAnnotator"/>
    <localInspection language="SQL" shortName="PhantomSqlWithoutWhere" key="inspection.PhantomSqlWithoutWhere" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlWithoutWhereInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlJoinWithoutOn" key="inspection.PhantomSqlJoinWithoutOn" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlJoinWithoutOnInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlUnusedCte" key="inspection.PhantomSqlUnusedCte" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlUnusedCteInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlRedundantAlias" key="inspection.PhantomSqlRedundantAlias" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlRedundantAliasInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlShadowingAlias" key="inspection.PhantomSqlShadowingAlias" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlShadowingAliasInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlInsertValues" key="inspection.PhantomSqlInsertValues" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlInsertValuesInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlUnionColumnCount" key="inspection.PhantomSqlUnionColumnCount" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlUnionColumnCountInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlMultipleLimit" key="inspection.PhantomSqlMultipleLimit" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlMultipleLimitInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlRedundantOrderingDirection" key="inspection.PhantomSqlRedundantOrderingDirection" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlRedundantOrderingDirectionInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlCaseVsCoalesce" key="inspection.PhantomSqlCaseVsCoalesce" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlCaseVsCoalesceInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlRedundantElseNull" key="inspection.PhantomSqlRedundantElseNull" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlRedundantElseNullInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlShouldBeInGroupBy" key="inspection.PhantomSqlShouldBeInGroupBy" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlShouldBeInGroupByInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlDerivedTableAlias" key="inspection.PhantomSqlDerivedTableAlias" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlDerivedTableAliasInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlMissingColumnAliases" key="inspection.PhantomSqlMissingColumnAliases" groupKey="inspection.group.sql"
                     enabledByDefault="false" level="WARNING" implementationClass="dev.phantom.db.core.SqlMissingColumnAliasesInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlAmbiguousColumn" key="inspection.PhantomSqlAmbiguousColumn" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlAmbiguousColumnInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlInsertNullIntoNotNull" key="inspection.PhantomSqlInsertNullIntoNotNull" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlInsertNullIntoNotNullInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlStringLengthExceeded" key="inspection.PhantomSqlStringLengthExceeded" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlStringLengthExceededInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlTypeMismatch" key="inspection.PhantomSqlTypeMismatch" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlTypeMismatchInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlNullComparison" key="inspection.PhantomSqlNullComparison" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlNullComparisonInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlConstantCondition" key="inspection.PhantomSqlConstantCondition" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.phantom.db.core.SqlConstantConditionInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlAggregateMisuse" key="inspection.PhantomSqlAggregateMisuse" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlAggregateMisuseInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlRedundantCoalesce" key="inspection.PhantomSqlRedundantCoalesce" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlRedundantCoalesceInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlRedundantLimit" key="inspection.PhantomSqlRedundantLimit" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlRedundantLimitInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlUnusedSubqueryItem" key="inspection.PhantomSqlUnusedSubqueryItem" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlUnusedSubqueryItemInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlDuplicateColumn" key="inspection.PhantomSqlDuplicateColumn" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlDuplicateColumnInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlOrderByPosition" key="inspection.PhantomSqlOrderByPosition" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlOrderByPositionInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlAddNotNullColumn" key="inspection.PhantomSqlAddNotNullColumn" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlAddNotNullColumnInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlDeprecatedType" key="inspection.PhantomSqlDeprecatedType" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.phantom.db.core.SqlDeprecatedTypeInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlUsingColumns" key="inspection.PhantomSqlUsingColumns" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlUsingColumnsInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlNotNullColumnTest" key="inspection.PhantomSqlNotNullColumnTest" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.phantom.db.core.SqlNotNullColumnTestInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlAutoIncrementDuplicate" key="inspection.PhantomSqlAutoIncrementDuplicate" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="ERROR" implementationClass="dev.phantom.db.core.SqlAutoIncrementDuplicateInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlFunctionSpace" key="inspection.PhantomSqlFunctionSpace" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlFunctionSpaceInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlInsertIntoGeneratedColumn" key="inspection.PhantomSqlInsertIntoGeneratedColumn" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="ERROR" implementationClass="dev.phantom.db.core.SqlInsertIntoGeneratedColumnInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlMisleadingReference" key="inspection.PhantomSqlMisleadingReference" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.phantom.db.core.SqlMisleadingReferenceInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlFunctionArguments" key="inspection.PhantomSqlFunctionArguments" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="ERROR" implementationClass="dev.phantom.db.core.SqlFunctionArgumentsInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlIfFunction" key="inspection.PhantomSqlIfFunction" groupKey="inspection.group.sql"
                     enabledByDefault="false" level="WEAK WARNING" implementationClass="dev.phantom.db.core.SqlIfFunctionInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlReservedIdentifier" key="inspection.PhantomSqlReservedIdentifier" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.phantom.db.core.SqlReservedIdentifierInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlDropIndexedColumn" key="inspection.PhantomSqlDropIndexedColumn" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.phantom.db.core.SqlDropIndexedColumnInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlTriggerTransition" key="inspection.PhantomSqlTriggerTransition" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="ERROR" implementationClass="dev.phantom.db.core.SqlTriggerTransitionInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlTransactionInTrigger" key="inspection.PhantomSqlTransactionInTrigger" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="ERROR" implementationClass="dev.phantom.db.core.SqlTransactionInTriggerInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlUnusedVariable" key="inspection.PhantomSqlUnusedVariable" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlUnusedVariableInspection"/>
    <localInspection language="SQL" shortName="PhantomSqlMissingReturn" key="inspection.PhantomSqlMissingReturn" groupKey="inspection.group.sql"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.phantom.db.core.SqlMissingReturnInspection"/>
    <lang.formatter language="SQL" implementationClass="dev.phantom.db.core.SqlFormattingModelBuilder"/>
    <lang.findUsagesProvider language="SQL" implementationClass="dev.phantom.db.core.SqlFindUsagesProvider"/>
    <runLineMarkerContributor language="SQL" implementationClass="dev.phantom.db.core.exec.SqlRunLineMarkerContributor"/>
    <editorNotificationProvider implementation="dev.phantom.db.core.exec.SqlDataSourceNotificationProvider"/>
    <actionPromoter implementation="dev.phantom.db.core.exec.SqlActionPromoter"/>
    <toolWindow id="Database" anchor="right" secondary="false" icon="AllIcons.Nodes.DataTables"
                factoryClass="dev.phantom.db.core.ui.DbToolWindowFactory"/>
    <toolWindow id="Database Changes" anchor="bottom" secondary="false" icon="AllIcons.Vcs.Changelist"
                factoryClass="dev.phantom.db.core.ui.DbChangesToolWindowFactory"/>
    <projectCloseHandler implementation="dev.phantom.db.core.exec.DbPendingChangesCloseHandler"/>
    <notificationGroup id="Phantom Database" displayType="BALLOON" bundle="messages.PhantomDbBundle" key="db.notification.group"/>
  </extensions>
  <actions resource-bundle="messages.PhantomDbBundle">
    <action id="PhantomDb.RunStatement" class="dev.phantom.db.core.exec.SqlRunStatementAction" icon="AllIcons.Actions.Execute">
      <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <action id="PhantomDb.SelectDataSource" class="dev.phantom.db.core.exec.SqlSelectDataSourceAction">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="PhantomDb.RunStatement"/>
    </action>
    <action id="PhantomDb.ShowHistory" class="dev.phantom.db.core.exec.DbShowHistoryAction" icon="AllIcons.Vcs.History">
      <keyboard-shortcut keymap="$default" first-keystroke="control alt E"/>
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="PhantomDb.SelectDataSource"/>
    </action>
    <action id="PhantomDb.ExplainPlan" class="dev.phantom.db.core.exec.DbExplainPlanAction">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="PhantomDb.RunStatement"/>
    </action>
    <action id="PhantomDb.ExplainAnalyze" class="dev.phantom.db.core.exec.DbExplainAnalyzeAction">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="PhantomDb.ExplainPlan"/>
    </action>
    <action id="PhantomDb.ManualCommit" class="dev.phantom.db.core.exec.DbManualCommitToggleAction">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="PhantomDb.ShowHistory"/>
    </action>
    <action id="PhantomDb.Commit" class="dev.phantom.db.core.exec.DbCommitAction" icon="AllIcons.Actions.Commit">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="PhantomDb.ManualCommit"/>
    </action>
    <action id="PhantomDb.Rollback" class="dev.phantom.db.core.exec.DbRollbackAction" icon="AllIcons.Actions.Rollback">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="PhantomDb.Commit"/>
    </action>
    <action id="PhantomDb.ShowDatabase" class="dev.phantom.db.core.ui.DbShowToolWindowAction" icon="AllIcons.Nodes.DataTables">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
