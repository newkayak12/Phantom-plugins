<idea-plugin>
  <!-- Phantom's own id; intellij.execution.serviceView.plugin stays as an alias. The content module names stay the IntelliJ
       ones, as other plugins depend on them by name. The bundled IntelliJ Services View plugin has to be gone, or both
       claim the same id and modules. -->
  <id>dev.phantom.serviceview</id>
  <name>Services View</name>
  <module value="intellij.execution.serviceView.plugin"/>
  <vendor url="https://github.com/newkayak12/Phantom-plugins">Phantom</vendor>
  <category>Tools Integration</category>
  <description><![CDATA[
    The Services tool window: run configurations, servers, databases, Docker and other services in one place.
    <br/>
    Based on the IntelliJ Community Services View plugin (Apache 2.0).
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
  </dependencies>

  <!-- One jar. The serviceView and dashboard modules load embedded: each one's package holds the packages of its backend and
       frontend modules, so it cannot have a class loader filtered to a package of its own. dashboard.frontend has no
       classes, so it has no package either and loads embedded too. The backend and frontend modules and clouds keep their
       own class loader on a package of their own. -->
  <content namespace="jetbrains">
    <module name="intellij.platform.execution.serviceView" loading="embedded"/>
    <module name="intellij.platform.execution.dashboard" loading="embedded"/>
    <module name="intellij.platform.execution.dashboard.frontend" loading="embedded"/>
    <module name="intellij.platform.clouds"/>
    <module name="intellij.platform.execution.dashboard.backend"/>
    <module name="intellij.platform.execution.serviceView.backend"/>
    <module name="intellij.platform.execution.serviceView.frontend"/>
  </content>
</idea-plugin>
